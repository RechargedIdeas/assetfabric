<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used after the user pairs with a desktop (LoomLink, C5/C6). Standalone mode makes no
         network calls. No CAMERA permission: capture is delegated to the system camera app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A desktop's pairing QR (loomlink://pair?u=…&c=…) scanned by any camera app opens here;
                 the user still confirms before pairing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="loomlink" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Write target for the system camera app (EXTRA_OUTPUT); app-private, single file. -->
        <provider
            android:name=".CaptureProvider"
            android:authorities="com.rechargedideas.pocketloom.capture"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
