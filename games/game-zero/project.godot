; Engine configuration file.
; Godot 4.x — AssetFabric Game Zero 
; Target renderer: Compatibility (gl_compatibility) for 2D / mobile / Web.
; Do not switch to Forward+ without an ADR.

config_version=5

[application]

config/name="Game Zero"
config/description="AssetFabric MVP — 8-bit fighter/farming hybrid"
config/version="0.9.1+f9"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Fabric="*res://autoload/fabric.gd"
Live="*res://autoload/live.gd"
LiveOps="*res://autoload/liveops.gd"
A11y="*res://autoload/a11y.gd"
Retro="*res://autoload/retro.gd"
GIRT="*res://autoload/girt.gd"
CascadeHub="*res://autoload/cascade_hub.gd"
Save="*res://autoload/save.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
; F7: Android export requires ETC2/ASTC import support enabled (no effect on the runtime-loaded PNGs).
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/translations=PackedStringArray()

