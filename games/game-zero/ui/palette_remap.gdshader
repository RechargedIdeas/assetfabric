shader_type canvas_item;
// G-A11Y-01 (0.7.10): full-screen colour-blind palette remap. Game art is palette-constrained (PatternVault), so the
// variant is an exact colour → colour table generated by forge from content/patternvault/palettes.json
// (world.json "a11y"). Pixels that are not palette colours (text anti-aliasing, tints) pass through unchanged.
uniform sampler2D screen_tex : hint_screen_texture, filter_nearest;
uniform vec3 src[24];
uniform vec3 dst[24];
uniform int count = 0;
uniform float tolerance = 0.012;

void fragment() {
	vec4 c = texture(screen_tex, SCREEN_UV);
	vec3 o = c.rgb;
	for (int i = 0; i < 24; i++) {
		if (i >= count) {
			break;
		}
		vec3 d = abs(c.rgb - src[i]);
		if (max(d.r, max(d.g, d.b)) < tolerance) {
			o = dst[i];
			break;
		}
	}
	COLOR = vec4(o, 1.0);
}
